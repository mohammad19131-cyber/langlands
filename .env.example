# Copy to apps/web/.env.local (or repo-root .env.local if your runner loads it).
# Values live in the Supabase project dashboard. Never commit real keys.

# Project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key (safe in the browser only because RLS is on)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres URI for the round machine. Server only.
# Use session mode (port 5432), not the transaction pooler, if you rely on
# pg_advisory_xact_lock across a single SQL function call (already used
# inside 0006 RPCs). Leave empty for the not-configured API.
# SUPABASE_DB_URL=
