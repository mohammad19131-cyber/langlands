# Copy to apps/web/.env.local (Next.js loads env from the app directory).
# Dashboard → Project Settings → API. Never commit real keys.

# Project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (dashboard) / legacy anon JWT. Browser-safe because RLS is on.
# Do not put a secret / service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret key (dashboard) / legacy service_role JWT — server only.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct Postgres URI for the round machine. Server only.
# Use session mode (port 5432), not the transaction pooler, if you rely on
# pg_advisory_xact_lock across a single SQL function call (already used
# inside 0006 RPCs). Leave empty for the not-configured API.
# SUPABASE_DB_URL=

# Night-before team account provisioning (server only).
# POST /api/admin/provision-teams with Authorization: Bearer <this value>.
# TEAM_PROVISION_SECRET=
